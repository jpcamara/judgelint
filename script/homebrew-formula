#!/usr/bin/env ruby
# frozen_string_literal: true

# Prints the Homebrew formula for a release, from its version and SHA256SUMS:
#
#   script/homebrew-formula 0.1.0 SHA256SUMS > Formula/judgelint.rb
#
# The release job runs this to update github.com/jpcamara/homebrew-tap.

version, sums_path = ARGV
abort "usage: script/homebrew-formula VERSION SHA256SUMS" unless version && sums_path

sums = File.readlines(sums_path).to_h do |line|
  sum, file = line.split
  [file, sum]
end
release = "https://github.com/jpcamara/judgelint/releases/download/v#{version}"
asset = lambda do |target|
  name = "judgelint-#{target}.tar.gz"
  sum = sums.fetch(name) { abort "#{sums_path} has no #{name}" }
  %(url "#{release}/#{name}"\n      sha256 "#{sum}")
end

puts <<~RUBY
  # Generated by script/homebrew-formula in github.com/jpcamara/judgelint.
  class Judgelint < Formula
    desc "Check code against plain-English conventions using decision models"
    homepage "https://github.com/jpcamara/judgelint"
    version "#{version}"
    license "MIT"

    on_macos do
      on_arm do
        #{asset.call('aarch64-apple-darwin')}
      end
      on_intel do
        #{asset.call('x86_64-apple-darwin')}
      end
    end

    on_linux do
      on_arm do
        #{asset.call('aarch64-unknown-linux-gnu')}
      end
      on_intel do
        #{asset.call('x86_64-unknown-linux-gnu')}
      end
    end

    def install
      bin.install "judgelint"
    end

    test do
      assert_match version.to_s, shell_output("\#{bin}/judgelint --version")
    end
  end
RUBY
