#!/usr/bin/env ruby
# frozen_string_literal: true

# The platform gems (judgelint-*-arm64-darwin and so on) carry the binary in
# libexec/. The plain gem, for every other platform, has none.
native = File.expand_path("../libexec/judgelint", __dir__)
exec(native, *ARGV) if File.executable?(native)

abort <<~TEXT
  judgelint has no build for #{RUBY_PLATFORM}, only for macOS and Linux on arm64
  and x86_64. With Rust installed, build it from source:

    cargo install --git https://github.com/jpcamara/judgelint
TEXT
