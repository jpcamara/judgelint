#!/usr/bin/env ruby
# frozen_string_literal: true

# A platform gem (judgelint-*-arm64-darwin and so on) carries the Spinel-built
# binary in libexec/; run it when it's there. Spinel compiles this file too,
# and drops this branch.
if RUBY_ENGINE != "spinel"
  native = File.expand_path("../libexec/judgelint", __dir__)
  exec(native, *ARGV) if File.executable?(native)
end

require "judgelint"

exit Judgelint::CLI.new(ARGV).run
